# Provider priority list (comma-separated, evaluated in order)
# Supported options: gemini, groq, ollama
PROVIDERS=gemini,groq,ollama

# Response cache toggle: set to 'off' to bypass disk cache
CACHE=on

# Google Gemini provider settings
GEMINI_API_KEY=your_gemini_api_key_from_aistudio
GEMINI_MODEL=gemini-2.5-flash

# Groq provider settings (OpenAI-compatible cloud endpoint, fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama provider settings (Local OpenAI-compatible inference, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Server Port
PORT=5000
